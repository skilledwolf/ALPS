  "qsharp_source": "operation QuenchEvolve(q : Qubit[], steps : Int, dt : Double) : Unit is Adj + Ctl {\n    for _ in 1..steps {\n        Exp([PauliZ, PauliZ, PauliI, PauliI, PauliI, PauliI], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliI, PauliZ, PauliZ, PauliI, PauliI, PauliI], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliZ, PauliZ, PauliI, PauliI], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliZ, PauliZ, PauliI], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliZ, PauliZ], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliX, PauliI, PauliI, PauliI, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliZ, PauliI, PauliI, PauliI, PauliI, PauliI], (-0.07000000000000001) * dt / 2.0, q);\n        Exp([PauliI, PauliX, PauliI, PauliI, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliZ, PauliI, PauliI, PauliI, PauliI], (0.13000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliX, PauliI, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliZ, PauliI, PauliI, PauliI], (-0.19000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliX, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliZ, PauliI, PauliI], (0.09000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliX, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliZ, PauliI], (-0.16000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliI, PauliX], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliI, PauliZ], (0.20999999999999999) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliI, PauliZ], (0.20999999999999999) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliI, PauliX], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliZ, PauliI], (-0.16000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliX, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliZ, PauliI, PauliI], (0.09000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliX, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliZ, PauliI, PauliI, PauliI], (-0.19000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliX, PauliI, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliZ, PauliI, PauliI, PauliI, PauliI], (0.13000000000000000) * dt / 2.0, q);\n        Exp([PauliI, PauliX, PauliI, PauliI, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliZ, PauliI, PauliI, PauliI, PauliI, PauliI], (-0.07000000000000001) * dt / 2.0, q);\n        Exp([PauliX, PauliI, PauliI, PauliI, PauliI, PauliI], (0.80000000000000004) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliI, PauliZ, PauliZ], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliI, PauliZ, PauliZ, PauliI], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliI, PauliI, PauliZ, PauliZ, PauliI, PauliI], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliI, PauliZ, PauliZ, PauliI, PauliI, PauliI], (0.69999999999999996) * dt / 2.0, q);\n        Exp([PauliZ, PauliZ, PauliI, PauliI, PauliI, PauliI], (0.69999999999999996) * dt / 2.0, q);\n    }\n}\noperation QuenchShot(steps : Int, dt : Double) : Result[] {\n    use q = Qubit[6];\n    QuenchEvolve(q, steps, dt);\n    let results = [M(q[0]), M(q[1]), M(q[2]), M(q[3]), M(q[4]), M(q[5])];\n    ResetAll(q);\n    return results;\n}\n",
